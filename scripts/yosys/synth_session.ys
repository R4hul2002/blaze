# =============================================================================
# synth_session.ys — Yosys synthesis script for Session modules
# Project: BLAZE NGFW
# =============================================================================

# Read package and session modules
read_verilog -sv rtl/pkg/blaze_pkg.sv
read_verilog -sv rtl/session/flow_hash.sv
read_verilog -sv rtl/session/flow_table.sv

# Synthesize flow_hash
hierarchy -check -top flow_hash
proc; opt; fsm; opt; memory; opt;
techmap; opt;
alumacc; share; opt;
abc -lut 6; clean;
stat;
write_verilog -noattr synth_out/flow_hash_synth.v
write_json synth_out/flow_hash_synth.json
tee -o synth_out/flow_hash_stats.txt stat

# Synthesize flow_table
design -reset
read_verilog -sv rtl/pkg/blaze_pkg.sv
read_verilog -sv rtl/session/flow_table.sv
hierarchy -check -top flow_table
proc; opt; fsm; opt; memory; opt;
techmap; opt;
alumacc; share; opt;
abc -lut 6; clean;
stat;
write_verilog -noattr synth_out/flow_table_synth.v
write_json synth_out/flow_table_synth.json
tee -o synth_out/flow_table_stats.txt stat
