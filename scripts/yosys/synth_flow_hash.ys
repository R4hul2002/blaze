# =============================================================================
# synth_flow_hash.ys — Flow Hash synthesis (standalone)
# =============================================================================

# Define minimal types inline
read_verilog -sv << EOT

package blaze_pkg;
  parameter int IPV4_WIDTH = 32;
  parameter int IPV6_WIDTH = 128;
  parameter int PORT_WIDTH = 16;
  parameter int HASH_WIDTH = 32;
  
  typedef struct packed {
    logic is_ipv6;
    logic [IPV4_WIDTH-1:0] src_ip4;
    logic [IPV4_WIDTH-1:0] dst_ip4;
    logic [IPV6_WIDTH-1:0] src_ip6;
    logic [IPV6_WIDTH-1:0] dst_ip6;
    logic [PORT_WIDTH-1:0] src_port;
    logic [PORT_WIDTH-1:0] dst_port;
    logic [7:0] ip_proto;
  } pkt_meta_t;
endpackage

module flow_hash #(
  parameter bit SYMMETRIC = 1
)(
  input  wire        clk,
  input  wire        rst_n,
  input  blaze_pkg::pkt_meta_t  meta_in,
  input  wire        meta_valid,
  output reg  [31:0] hash_out,
  output reg         hash_valid
);

  import blaze_pkg::*;

  function automatic logic [31:0] crc32_byte(
    input logic [31:0] crc,
    input logic [7:0]  data
  );
    logic [31:0] c;
    logic [31:0] poly;
    poly = 32'hEDB88320;
    c = crc ^ {24'h0, data};
    // Unroll loop for Yosys compatibility
    c = c[0] ? ((c >> 1) ^ poly) : (c >> 1);
    c = c[0] ? ((c >> 1) ^ poly) : (c >> 1);
    c = c[0] ? ((c >> 1) ^ poly) : (c >> 1);
    c = c[0] ? ((c >> 1) ^ poly) : (c >> 1);
    c = c[0] ? ((c >> 1) ^ poly) : (c >> 1);
    c = c[0] ? ((c >> 1) ^ poly) : (c >> 1);
    c = c[0] ? ((c >> 1) ^ poly) : (c >> 1);
    c = c[0] ? ((c >> 1) ^ poly) : (c >> 1);
    return c;
  endfunction

  logic [31:0] h_fwd, h_rev, h_final;
  logic [31:0] src_ip, dst_ip;
  logic [15:0] sp, dp;
  logic [7:0]  proto;

  always_comb begin
    if (meta_in.is_ipv6) begin
      src_ip = meta_in.src_ip6[127:96] ^ meta_in.src_ip6[95:64] ^
               meta_in.src_ip6[63:32]  ^ meta_in.src_ip6[31:0];
      dst_ip = meta_in.dst_ip6[127:96] ^ meta_in.dst_ip6[95:64] ^
               meta_in.dst_ip6[63:32]  ^ meta_in.dst_ip6[31:0];
    end else begin
      src_ip = meta_in.src_ip4;
      dst_ip = meta_in.dst_ip4;
    end
    sp    = meta_in.src_port;
    dp    = meta_in.dst_port;
    proto = meta_in.ip_proto;

    h_fwd = 32'hFFFFFFFF;
    h_fwd = crc32_byte(h_fwd, src_ip[31:24]);
    h_fwd = crc32_byte(h_fwd, src_ip[23:16]);
    h_fwd = crc32_byte(h_fwd, src_ip[15:8]);
    h_fwd = crc32_byte(h_fwd, src_ip[7:0]);
    h_fwd = crc32_byte(h_fwd, dst_ip[31:24]);
    h_fwd = crc32_byte(h_fwd, dst_ip[23:16]);
    h_fwd = crc32_byte(h_fwd, dst_ip[15:8]);
    h_fwd = crc32_byte(h_fwd, dst_ip[7:0]);
    h_fwd = crc32_byte(h_fwd, sp[15:8]);
    h_fwd = crc32_byte(h_fwd, sp[7:0]);
    h_fwd = crc32_byte(h_fwd, dp[15:8]);
    h_fwd = crc32_byte(h_fwd, dp[7:0]);
    h_fwd = crc32_byte(h_fwd, proto);
    h_fwd = ~h_fwd;

    if (SYMMETRIC) begin
      h_rev = 32'hFFFFFFFF;
      h_rev = crc32_byte(h_rev, dst_ip[31:24]);
      h_rev = crc32_byte(h_rev, dst_ip[23:16]);
      h_rev = crc32_byte(h_rev, dst_ip[15:8]);
      h_rev = crc32_byte(h_rev, dst_ip[7:0]);
      h_rev = crc32_byte(h_rev, src_ip[31:24]);
      h_rev = crc32_byte(h_rev, src_ip[23:16]);
      h_rev = crc32_byte(h_rev, src_ip[15:8]);
      h_rev = crc32_byte(h_rev, src_ip[7:0]);
      h_rev = crc32_byte(h_rev, dp[15:8]);
      h_rev = crc32_byte(h_rev, dp[7:0]);
      h_rev = crc32_byte(h_rev, sp[15:8]);
      h_rev = crc32_byte(h_rev, sp[7:0]);
      h_rev = crc32_byte(h_rev, proto);
      h_rev = ~h_rev;
      h_final = h_fwd ^ h_rev;
    end else
      h_final = h_fwd;
  end

  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      hash_out   <= 32'd0;
      hash_valid <= 1'b0;
    end else begin
      hash_out   <= h_final;
      hash_valid <= meta_valid;
    end
  end

endmodule

EOT

# Set hierarchy
hierarchy -check -top flow_hash

# Synthesis flow
proc
opt
fsm
opt
memory
opt
techmap
opt
alumacc
share
opt
abc -lut 6
clean

# Statistics
stat
tee -o synth_out/flow_hash_stats.txt stat

# Write outputs
write_verilog -noattr synth_out/flow_hash_synth.v
write_json synth_out/flow_hash_synth.json

echo ""
echo "Flow Hash synthesis complete!"
echo "Output files in synth_out/"
