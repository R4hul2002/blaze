# =============================================================================
# synth_acl_simple.ys — ACL Engine synthesis (Yosys-compatible)
# =============================================================================
# This script synthesizes the ACL engine by pre-processing the package
# to work around Yosys SystemVerilog limitations

# Read only the necessary parts - ACL engine should work standalone
# if we define the types it needs inline

read_verilog -sv << EOT

// Minimal type definitions for ACL engine
package blaze_pkg;
  
  // Basic parameters
  parameter int IPV4_WIDTH = 32;
  parameter int IPV6_WIDTH = 128;
  parameter int PORT_WIDTH = 16;
  parameter int PROTO_WIDTH = 8;
  parameter int QUEUE_WIDTH = 4;
  parameter int ZONE_WIDTH = 8;
  
  // Protocol enum
  typedef enum logic [7:0] {
    PROTO_ICMP   = 8'h01,
    PROTO_TCP    = 8'h06,
    PROTO_UDP    = 8'h11,
    PROTO_ICMPv6 = 8'h3A,
    PROTO_OTHER  = 8'hFF
  } proto_t;
  
  // Action enum
  typedef enum logic [3:0] {
    ACTION_ACCEPT  = 4'd0,
    ACTION_DROP    = 4'd1,
    ACTION_REJECT  = 4'd2,
    ACTION_LOG     = 4'd3,
    ACTION_MIRROR  = 4'd4,
    ACTION_MODIFY  = 4'd5,
    ACTION_QOS     = 4'd6,
    ACTION_NAT     = 4'd7,
    ACTION_LIMIT   = 4'd8,
    ACTION_INSPECT = 4'd9
  } action_t;
  
  // App ID enum
  typedef enum logic [7:0] {
    APP_UNKNOWN = 8'd0,
    APP_HTTP    = 8'd1,
    APP_HTTPS   = 8'd2,
    APP_DNS     = 8'd3,
    APP_SSH     = 8'd4,
    APP_FTP     = 8'd5,
    APP_SMTP    = 8'd6,
    APP_POP3    = 8'd7,
    APP_IMAP    = 8'd8,
    APP_DHCP    = 8'd9
  } app_id_t;
  
  // Simplified packet metadata - just what ACL needs
  typedef struct packed {
    logic [IPV4_WIDTH-1:0] src_ip4;
    logic [IPV4_WIDTH-1:0] dst_ip4;
    logic [PORT_WIDTH-1:0] src_port;
    logic [PORT_WIDTH-1:0] dst_port;
    logic [PROTO_WIDTH-1:0] ip_proto;
    app_id_t app_id;
    logic [ZONE_WIDTH-1:0] src_zone;
    action_t action;
  } pkt_meta_t;
  
  // Rule entry
  typedef struct packed {
    logic [31:0] rule_id;
    logic [IPV4_WIDTH-1:0] src_ip;
    logic [IPV4_WIDTH-1:0] src_mask;
    logic [IPV4_WIDTH-1:0] dst_ip;
    logic [IPV4_WIDTH-1:0] dst_mask;
    logic [PORT_WIDTH-1:0] src_port_lo;
    logic [PORT_WIDTH-1:0] src_port_hi;
    logic [PORT_WIDTH-1:0] dst_port_lo;
    logic [PORT_WIDTH-1:0] dst_port_hi;
    logic [PROTO_WIDTH-1:0] protocol;
    app_id_t app_id;
    action_t action;
    logic [ZONE_WIDTH-1:0] src_zone;
    logic log_en;
    logic mirror_en;
    logic [QUEUE_WIDTH-1:0] qos_queue;
    logic [31:0] rule_priority;
    logic enabled;
  } rule_entry_t;
  
endpackage

EOT

# Now read the ACL engine
read_verilog -sv rtl/acl/acl_engine.sv

# Set hierarchy
hierarchy -check -top acl_engine

# Synthesis flow
proc
opt
fsm
opt
memory
opt
techmap
opt
alumacc
share
opt
abc -lut 6
clean

# Statistics
stat
tee -o synth_out/acl_engine_stats.txt stat

# Write outputs
write_verilog -noattr synth_out/acl_engine_synth.v
write_json synth_out/acl_engine_synth.json

echo "ACL Engine synthesis complete!"
